import { ListView } from "std-widgets.slint";

// Visual tokens translated from xbar's real visual material as it stands
// in its working tree (`xbar/src/ui/style.rs`: `DOCK_BACKGROUND`,
// `GLASS_MATERIAL`, `POPUP_STYLE` — inspected there directly, not assumed
// from an earlier or a committed snapshot) — the same dark "glass"
// language xbar's dock and popups already use, not a palette invented
// independently for xdir:
//
//   background         <- DOCK_BACKGROUND / GLASS_MATERIAL.background rgb
//   surface             <- POPUP_STYLE.card_background rgb (xbar's content-
//                          card tone nested inside its popup shell)
//   surface-subtle      <- the same `surface` tone at reduced alpha, for a
//                          quieter indicator than `surface-selected`
//   surface-hover       <- POPUP_STYLE.hover_background (rgb + alpha)
//   surface-selected    <- BAR_STYLE.workspace_background — xbar's own
//                          "this one is active" tone
//   border              <- POPUP_STYLE.border
//   text-primary        <- GLASS_MATERIAL.foreground
//   text-secondary      <- POPUP_STYLE.muted_foreground
//   accent              <- BAR_STYLE.workspace_foreground /
//                          menu_hover_foreground ("emphasis white"); also
//                          CURRENT's selected-row indicator bar (see below)
//   radius              <- POPUP_STYLE.card_radius
//
// Exactly one set exists — no dark/light switch, no theme struct. A future
// xdir/xbar/xomposite-wide theme system is out of scope here (see the M5V
// decision note).
//
// `background`/`surface`/`surface-selected`/`border`/`text-primary`/
// `text-secondary`/`accent` are fully opaque; `surface-hover` and
// `surface-subtle` carry real alpha (translucent overlays meant to sit on
// top of an opaque row, not a base surface of their own). None of this is
// xomposite-mediated transparency — xdir does not participate in that
// contract this milestone (see the M5V "XOMPOSITE CONTRACT DELTA NEEDED"
// note — Slint/winit expose no small way to select an ARGB visual or set
// `_NET_WM_WINDOW_OPACITY`/`_KDE_NET_WM_BLUR_BEHIND_REGION` from
// application code today), so every *base* surface stays opaque and the
// window stays legible with no compositor running at all.
global Tokens {
    out property <color> background: #20242b;
    out property <color> surface: #2a303a;
    out property <color> surface-subtle: #2a303a80;
    out property <color> surface-hover: #5a687d72;
    out property <color> surface-selected: #3a4352;
    out property <color> border: #2b3340;
    out property <color> text-primary: #e6eaf0;
    out property <color> text-secondary: #7b8492;
    out property <color> accent: #ffffff;
    out property <length> radius: 7px;
    out property <length> row-height: 26px;
    out property <length> row-padding: 8px;
}

// A single row in the PARENT or PREVIEW-of-directory listings. Both are
// read-only projections built entirely in Rust (`ui/window.rs`): `text` is
// already the final display label (a trailing "/" for directories is added
// there, not here — `.slint` never inspects `EntryKind`), and `highlighted`
// marks PARENT's row for `current_dir`, identified by Rust via real `Path`
// equality, never by comparing this text.
struct ContextRow {
    text: string,
    highlighted: bool,
}

// A single CURRENT row: `text` is the same trailing-"/"-for-directories
// label as `ContextRow`, and `icon` is a single Nerd Font glyph Rust picks
// from `EntryKind` alone (see `ui/window.rs::entry_icon`) — `.slint` never
// inspects `EntryKind` or decides glyphs itself, same rule as `ContextRow`.
struct EntryRow {
    text: string,
    icon: string,
}

export component MainWindow inherits Window {
    title: "xdir";
    // `preferred-width`/`preferred-height` are hints for the *initial*
    // size only. Plain `width`/`height` on the root Window are a fixed-size
    // constraint in Slint (documented: the window manager is told
    // min-width == max-width == width), which made i3 treat this window as
    // non-resizable in tiling. A normal, cooperative X11 window must leave
    // the window manager as the authority over its actual geometry.
    // Widened for Milestone 3's three-pane layout (was 640px for the
    // single-pane 1B/2 UI); still just an initial hint, not a constraint.
    preferred-width: 960px;
    preferred-height: 420px;
    background: Tokens.background;
    // xdir's global typeface, resolved by the system's fontconfig (see
    // `fc-match "MesloLGS Nerd Font Mono"`), for text that inherits the
    // Window default rather than setting its own `font-family`. As of M5V,
    // CURRENT is an authorial `ListView` composition (see below), so it
    // inherits this like every other pane — the earlier `StandardListView`
    // exception (its `fluent-dark` delegate never inherited this value) no
    // longer applies to CURRENT specifically, but is kept as a documented
    // fact about that widget in case it's ever reintroduced elsewhere.
    default-font-family: "MesloLGS Nerd Font Mono";

    in property <string> path-text: "";
    in property <string> status-text: "0 items";
    in property <[EntryRow]> entries;
    in property <int> current-index: -1;

    // PARENT: read-only context, never navigable. `has-parent` is an
    // explicit signal from Rust (current_dir().parent() being None at
    // root) rather than something `.slint` infers from `parent-entries`
    // being empty, which could also happen if the parent just failed to
    // read.
    in property <bool> has-parent: false;
    in property <[ContextRow]> parent-entries;

    // PREVIEW: read-only context for whatever is selected in CURRENT.
    // `preview-mode` picks which of the views below to show; it's a tag
    // Rust computes from `PreviewContext`/`FilePreview` (never something
    // `.slint` derives from file kind, format, or bytes itself — see
    // `ui/window.rs`). "directory" and "text" render `preview-entries`
    // through the same per-row `ListView`: `.slint` receives an already-
    // validated-UTF-8, already-row-split list (see
    // `ui/window.rs::preview_text_rows`) and does no filesystem I/O,
    // truncation, or line-splitting of its own. "text" additionally shows
    // `preview-truncated`. "image" shows `preview-image` — already decoded
    // and size-checked in Rust (`core::image::read_image_preview`); Slint
    // never opens a file or decodes a format itself here, only paints
    // pixels it was handed. Every other mode ("none", "empty",
    // "unsupported", "unavailable", "symlink", "other") shows
    // `preview-label`, a plain contextual message (this covers
    // `FilePreview::TooLarge` too — a distinct label, not a distinct mode;
    // see `ui/window.rs::refresh_preview`).
    in property <string> preview-mode: "none";
    in property <[ContextRow]> preview-entries;
    in property <string> preview-label: "";
    in property <bool> preview-truncated: false;
    in property <image> preview-image;

    // FILTER: a local, incremental substring filter over CURRENT's
    // already-loaded entries — no filesystem traversal happens here or in
    // `AppState` for this (see `ui/window.rs`). `filter-query` is a
    // two-way alias straight through to the editable `TextInput` below
    // (the same `text <=> text-input.text` pattern Slint's own `LineEdit`
    // uses to expose an editable primitive's text outward), so Rust can
    // both read the live text on every keystroke (`filter-edited`) and
    // pre-fill it when `/` reopens an already-active filter. `filter-
    // editing` is pure UI-focus state, never `AppState`: it only decides
    // whether the input box is shown and focused — the query itself keeps
    // filtering CURRENT live whether or not the box happens to be open
    // right now. `mode-text` is the bottom bar's left-hand label
    // ("NORMAL" / "FILTER: <query>"), built entirely in Rust like every
    // other display string here — `.slint` never decides what it says.
    in-out property <string> filter-query: "";
    in property <bool> filter-editing: false;
    in property <string> mode-text: "NORMAL";
    callback filter-edited(string);
    callback filter-accepted();
    callback filter-escaped();

    // UI never touches the filesystem or Navigation, and never decides
    // what a keystroke or click *means* — it only reports what happened.
    // `key-input` forwards the pressed key's raw text (or, for the arrow
    // keys, one of the "Up"/"Down"/"Left"/"Right" tags below — arrows are
    // the one case only Slint can recognize, via its own `Key.*Arrow`
    // constants) plus the raw modifier flags, and gets back whether the
    // app layer consumed it (so unclaimed combinations, e.g. Mod+j, stay
    // available to the window manager instead of being swallowed here).
    callback key-input(string, bool, bool, bool, bool) -> bool;
    callback selection-changed(int);
    // `is-left` lets the Rust side ignore right/middle presses outright
    // when tracking double-clicks, without needing to know the Slint
    // button enum.
    callback item-pressed(int, bool);

    // Scrolls CURRENT's viewport just enough to bring `index` fully into
    // view — the same "bring into view" math Slint's own `StandardListView`
    // uses internally (`widgets/common/listview.slint::bring-into-view`),
    // reimplemented here against our own fixed `Tokens.row-height` since
    // CURRENT is no longer a `StandardListView`. `viewport-y` is a
    // negative-going offset (0 at the top); this only ever *reduces* how
    // far the target row is outside the visible range, never scrolls
    // further than necessary.
    public function scroll-to-index(index: int) {
        if (index < 0) {
            return;
        }
        if (current-list.viewport-y + index * Tokens.row-height < 0px) {
            current-list.viewport-y = 0px - index * Tokens.row-height;
        }
        if (current-list.viewport-y + index * Tokens.row-height + Tokens.row-height > current-list.visible-height) {
            current-list.viewport-y = current-list.visible-height - index * Tokens.row-height - Tokens.row-height;
        }
    }

    // Called whenever the listing changes (new directory), so a viewport
    // scrolled deep into the previous directory's list doesn't leak into
    // the newly loaded one.
    public function reset-scroll() {
        current-list.viewport-y = 0px;
    }

    public function focus-list() {
        focus-scope.focus();
    }

    // Called right after `/` (fresh or reopening an active filter) shows
    // the input box, so keyboard focus moves there in the same tick —
    // never left for a later frame, which is what `key-input`'s FocusScope
    // would otherwise still be holding.
    public function focus-filter-input() {
        filter-input.focus();
    }

    VerticalLayout {
        Rectangle {
            height: 30px;
            background: Tokens.surface;
            Text {
                text: root.path-text;
                color: Tokens.text-primary;
                x: 10px;
                vertical-alignment: center;
            }
        }

        Rectangle {
            height: 1px;
            background: Tokens.border;
        }

        HorizontalLayout {
            // PARENT — context only. A plain `ListView` (not
            // `StandardListView`): it has no `FocusScope` and no
            // click-to-select of its own (confirmed by reading Slint's own
            // `widgets/common/listview.slint` — only `StandardListView`
            // adds the `i-focus-scope`/`TouchArea` that make a row
            // selectable and focusable), so it can never steal keyboard
            // focus from CURRENT or turn a click into a selection/
            // navigation, with no extra "read-only" wrapping needed.
            //
            // Proportions are an initial visual ratio (PARENT 24 / CURRENT
            // 38 / PREVIEW 38), not fixed widths — `horizontal-stretch`
            // keeps them responsive to the window's real size. Each pane
            // also pins `preferred-width`/`min-width` to `0px`: without
            // that, `HorizontalLayout` first satisfies every child's own
            // intrinsic minimum/preferred width (driven by its longest
            // unwrapped row of text) before distributing the rest by
            // stretch, so a pane with wider content quietly grabbed more
            // than its share — confirmed via this milestone's own
            // measurements (PARENT's real xbar filenames pushed it several
            // points over 24%). Zeroing both makes every pane's width a
            // pure function of `horizontal-stretch`, regardless of what its
            // rows contain; overflowing text still elides/clips inside its
            // own pane exactly as before.
            Rectangle {
                horizontal-stretch: 24;
                preferred-width: 0px;
                min-width: 0px;
                background: Tokens.background;
                VerticalLayout {
                    Rectangle {
                        height: 20px;
                        background: Tokens.surface;
                        Text {
                            text: "PARENT";
                            color: Tokens.text-secondary;
                            x: 8px;
                            vertical-alignment: center;
                        }
                    }
                    if root.has-parent: ListView {
                        for row[i] in root.parent-entries: Rectangle {
                            height: 22px;
                            background: row.highlighted ? Tokens.surface-subtle : transparent;
                            Text {
                                text: row.text;
                                color: row.highlighted ? Tokens.text-primary : Tokens.text-secondary;
                                x: 8px;
                                vertical-alignment: center;
                            }
                        }
                    }
                    if !root.has-parent: Rectangle {
                        Text {
                            text: "(no parent)";
                            color: Tokens.text-secondary;
                            x: 8px;
                            y: 6px;
                        }
                    }
                }
            }

            Rectangle {
                width: 1px;
                horizontal-stretch: 0;
                background: Tokens.border;
            }

            // CURRENT — the only operational pane: keyboard, selection,
            // click and double-click all continue to work exactly as
            // before M5V. Rendered as an authorial `ListView` + row
            // delegate (Rectangle + icon + name + `TouchArea`) rather than
            // `StandardListView`, so Meslo applies uniformly, hover/
            // selected use xdir's own tokens instead of the toolkit's blue,
            // and every row gets a leading `EntryKind` icon — see the M5V
            // decision note for why `StandardListView` was replaced.
            //
            // `AppState` remains the sole authority over selection: this
            // pane only reflects `root.current-index` (set by Rust after
            // every `dispatch`) and reports raw interaction back through
            // `selection-changed`/`item-pressed`, exactly the callbacks
            // `StandardListView` used to drive. No selection state is
            // duplicated or decided here.
            Rectangle {
                horizontal-stretch: 38;
                preferred-width: 0px;
                min-width: 0px;
                VerticalLayout {
                    Rectangle {
                        height: 20px;
                        background: Tokens.surface;
                        Text {
                            text: "CURRENT";
                            color: Tokens.text-secondary;
                            x: 8px;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        focus-scope := FocusScope {
                            width: 100%;
                            height: 100%;

                            // This handler *identifies* the key (including
                            // recognizing the arrows via Slint's own
                            // `Key.*Arrow` constants, which nothing outside
                            // Slint can do) and reports raw modifier flags —
                            // it does not decide what any combination means
                            // for xdir. That decision, and whether the event
                            // should be consumed, comes back from
                            // `root.key-input(...)`.
                            key-pressed(event) => {
                                if (event.text == Key.UpArrow) {
                                    if (root.key-input("Up", event.modifiers.shift, event.modifiers.control, event.modifiers.alt, event.modifiers.meta)) { accept } else { reject }
                                } else if (event.text == Key.DownArrow) {
                                    if (root.key-input("Down", event.modifiers.shift, event.modifiers.control, event.modifiers.alt, event.modifiers.meta)) { accept } else { reject }
                                } else if (event.text == Key.LeftArrow) {
                                    if (root.key-input("Left", event.modifiers.shift, event.modifiers.control, event.modifiers.alt, event.modifiers.meta)) { accept } else { reject }
                                } else if (event.text == Key.RightArrow) {
                                    if (root.key-input("Right", event.modifiers.shift, event.modifiers.control, event.modifiers.alt, event.modifiers.meta)) { accept } else { reject }
                                } else if (event.text == Key.Escape) {
                                    if (root.key-input("Escape", event.modifiers.shift, event.modifiers.control, event.modifiers.alt, event.modifiers.meta)) { accept } else { reject }
                                } else if (event.text == Key.Shift || event.text == Key.ShiftR) {
                                    if (root.key-input("Shift", event.modifiers.shift, event.modifiers.control, event.modifiers.alt, event.modifiers.meta)) { accept } else { reject }
                                } else if (root.key-input(event.text, event.modifiers.shift, event.modifiers.control, event.modifiers.alt, event.modifiers.meta)) {
                                    accept
                                } else {
                                    reject
                                }
                            }

                            current-list := ListView {
                                width: 100%;
                                height: 100%;

                                // CURRENT's visible height changes whenever
                                // the window (or the pane) is resized —
                                // `scroll-to-index` doesn't run on its own
                                // just because the viewport moved, so
                                // without this the selected row could end
                                // up partially or fully outside the new
                                // viewport until the next navigation action.
                                // Re-running the same "bring into view" call
                                // used after every selection change keeps it
                                // visible across a resize too, with no
                                // timer, poll, or animation — `scroll-to-
                                // index` itself already no-ops (`index <
                                // 0`) before any row exists.
                                changed height => {
                                    root.scroll-to-index(root.current-index);
                                }

                                for row[i] in root.entries: Rectangle {
                                    height: Tokens.row-height;
                                    // The hover/selected background and the
                                    // `TouchArea` hit rect below are the
                                    // exact same `Rectangle` — one geometry,
                                    // never drawn in one rect and hit-tested
                                    // in another.
                                    background: i == root.current-index
                                        ? Tokens.surface-selected
                                        : (touch.has-hover ? Tokens.surface-hover : transparent);
                                    border-radius: Tokens.radius;

                                    // `surface-selected` and `surface-hover`
                                    // land close enough in perceived tone
                                    // (both are muted slate) that the
                                    // background alone doesn't reliably read
                                    // as two different states — this left
                                    // accent bar is xdir's own
                                    // `Tokens.accent` (xbar's "emphasis
                                    // white", the same tone its active-
                                    // workspace/hovered-menu text already
                                    // uses) and appears *only* for the
                                    // selected row, never on hover, so the
                                    // two states stay visually distinct
                                    // without inventing a new color or
                                    // reaching for toolkit blue.
                                    if i == root.current-index: Rectangle {
                                        x: 2px;
                                        y: 3px;
                                        width: 3px;
                                        height: parent.height - 6px;
                                        border-radius: 1.5px;
                                        background: Tokens.accent;
                                    }

                                    HorizontalLayout {
                                        padding-left: Tokens.row-padding;
                                        padding-right: Tokens.row-padding;
                                        spacing: 6px;

                                        Text {
                                            text: row.icon;
                                            color: Tokens.text-secondary;
                                            vertical-alignment: center;
                                            horizontal-stretch: 0;
                                        }
                                        Text {
                                            text: row.text;
                                            color: Tokens.text-primary;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                    }

                                    touch := TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        // Mirrors `StandardListView`'s own
                                        // click handling: a left press
                                        // always selects (re-selecting the
                                        // already-current row is a no-op in
                                        // `AppState::select_index`, so this
                                        // never has to check `i ==
                                        // current-index` itself); every
                                        // press — left or not — is also
                                        // reported to `item-pressed` for
                                        // Rust's own double-click timing.
                                        // Right/middle presses never select,
                                        // matching the old left-button-only
                                        // behavior.
                                        pointer-event(event) => {
                                            if (event.kind == PointerEventKind.down) {
                                                if (event.button == PointerEventButton.left) {
                                                    root.selection-changed(i);
                                                }
                                                root.item-pressed(i, event.button == PointerEventButton.left);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                width: 1px;
                horizontal-stretch: 0;
                background: Tokens.border;
            }

            // PREVIEW — context only, same non-interactive `ListView`
            // approach as PARENT when showing a directory's children; every
            // other mode shows a plain contextual message instead, never
            // file content.
            Rectangle {
                horizontal-stretch: 38;
                preferred-width: 0px;
                min-width: 0px;
                background: Tokens.background;
                VerticalLayout {
                    Rectangle {
                        height: 20px;
                        background: Tokens.surface;
                        Text {
                            text: "PREVIEW";
                            color: Tokens.text-secondary;
                            x: 8px;
                            vertical-alignment: center;
                        }
                    }
                    // Directory listings: unchanged from Milestone 3 — a
                    // read-only `ListView` (not `StandardListView` — no
                    // focus, no click-to-select, so it can never steal
                    // `j`/`k`/`h`/`l`/Enter/`.` from CURRENT's
                    // `focus-scope`), fixed-height, unwrapped rows. Kept as
                    // its own delegate, separate from "text" below, so
                    // fixing the text-row layout (Bug 2) can't change
                    // directory preview's visual behavior at all.
                    if root.preview-mode == "directory": ListView {
                        for row[i] in root.preview-entries: Rectangle {
                            height: 22px;
                            Text {
                                text: row.text;
                                color: Tokens.text-secondary;
                                x: 8px;
                                vertical-alignment: center;
                            }
                        }
                    }
                    // Text content: `preview-entries` is already split into
                    // short rows by `ui/window.rs::preview_text_rows`
                    // (never one big multi-line `Text` element — Slint
                    // 1.17.1's `renderer-software` glyph-run drawing panics,
                    // `euclid` `Option::unwrap()` on `None`, on a single
                    // `Text` holding either very many lines or one very
                    // long unbroken run, reproduced via this milestone's
                    // own smoke testing). Unlike directory rows, each one
                    // here still needs to *wrap* (a 200-character chunk is
                    // reliably wider than PREVIEW) and reflow on resize:
                    // `width` is bound to the row's own real width from the
                    // layout (never a guessed character count — i3 can
                    // resize this pane at any time), and each row's
                    // `height` follows its `Text`'s `preferred-height` at
                    // that width — Slint's documented height-for-width
                    // behavior for a wrapped `Text` — instead of a fixed
                    // 22px that would clip wrapped lines.
                    if root.preview-mode == "text": VerticalLayout {
                        ListView {
                            for row[i] in root.preview-entries: Rectangle {
                                width: parent.width;
                                height: row-text.preferred-height + 4px;
                                row-text := Text {
                                    text: row.text;
                                    color: Tokens.text-secondary;
                                    x: 8px;
                                    y: 2px;
                                    width: parent.width - 16px;
                                    wrap: char-wrap;
                                }
                            }
                        }
                        if root.preview-truncated: Rectangle {
                            height: 18px;
                            Text {
                                text: "(truncated)";
                                color: Tokens.text-secondary;
                                x: 8px;
                                vertical-alignment: center;
                            }
                        }
                    }
                    // Image: `preview-image` already carries decoded,
                    // size-checked pixels (see `core::image`) — this is
                    // purely a paint step. `image-fit: contain` preserves
                    // aspect ratio and never crops or deforms.
                    //
                    // Both this Rectangle's and the `Image`'s `width`/
                    // `height` are bound explicitly to `100%` — not left
                    // unset — because an `Image` element's *natural*
                    // preferred-size is its source's pixel dimensions
                    // (3840×2160 for a 4K photo), and an unset `Rectangle`
                    // derives its own preferred-size from its child's. Left
                    // unset, that native size leaked upward into the
                    // surrounding `HorizontalLayout`'s stretch negotiation
                    // and visibly squeezed PARENT/CURRENT — confirmed via
                    // this milestone's own smoke testing. Binding `100%`
                    // on both makes each one strictly *inherit* its
                    // parent's already-computed size instead of
                    // contributing a size of its own, which breaks that
                    // feedback loop.
                    if root.preview-mode == "image": Rectangle {
                        width: 100%;
                        height: 100%;
                        Image {
                            source: root.preview-image;
                            width: 100%;
                            height: 100%;
                            preferred-width: 0px;
                            preferred-height: 0px;
                            image-fit: contain;
                        }
                    }
                    if root.preview-mode != "directory" && root.preview-mode != "text" && root.preview-mode != "image": Rectangle {
                        Text {
                            text: root.preview-label;
                            color: Tokens.text-secondary;
                            x: 8px;
                            y: 8px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Tokens.border;
        }

        Rectangle {
            height: 24px;
            background: Tokens.surface;
            Text {
                text: root.status-text;
                color: Tokens.text-secondary;
                x: 10px;
                vertical-alignment: center;
            }
            // Right-hand region: the mode label ("NORMAL" / "FILTER:
            // <query>", built in Rust) when the filter box is closed, or
            // the live editable box itself while it's open — never both at
            // once, and never a popup/modal/toolbar/fourth region. A fixed
            // width keeps this anchored to the right edge the same way the
            // single `Text` it replaces always was.
            Rectangle {
                x: parent.width - self.width - 10px;
                y: 0px;
                height: parent.height;
                width: 340px;

                // `filter-input` (below) must always be instantiated —
                // never behind an `if` — because `focus-filter-input()`
                // (a `public function` at the root) needs to resolve its
                // id at every call, including the very first `/` of a
                // session, which happens in the same tick as setting
                // `filter-editing: true`; a conditionally-instantiated
                // element's id is not resolvable from outside its own
                // `if` (confirmed against Slint 1.17.1 directly: the
                // compiler rejects it with "Cannot access id"). So every
                // element in this region is unconditionally present and
                // toggled with plain `visible:` instead — mode label and
                // "FILTER" label are never both visible at once, and
                // `filter-input` only overlaps the "FILTER" label's own
                // slot for the very short label its text starts after.
                Text {
                    x: 0px;
                    text: root.mode-text;
                    color: Tokens.text-secondary;
                    vertical-alignment: center;
                    visible: !root.filter-editing;
                }
                Text {
                    x: 0px;
                    text: "FILTER";
                    color: Tokens.text-secondary;
                    vertical-alignment: center;
                    visible: root.filter-editing;
                }
                // Bare `TextInput`, not `LineEdit`: M5V removed
                // `StandardListView` specifically because a styled
                // std-widget brought its own visual behavior that ignored
                // xdir's tokens/font — the same reasoning applies here, so
                // this is the lowest primitive Slint offers that still
                // gives real text editing (cursor, Backspace, Unicode
                // composition, focus) with zero toolkit chrome to fight.
                // Colors/font come from `Tokens`/the window's own
                // `default-font-family` (inherited, never re-set here),
                // exactly like every other `Text` in this file.
                filter-input := TextInput {
                    x: 55px;
                    y: 0px;
                    height: parent.height;
                    width: parent.width - self.x;
                    visible: root.filter-editing;
                    text <=> root.filter-query;
                    single-line: true;
                    color: Tokens.text-primary;
                    vertical-alignment: center;
                    edited => { root.filter-edited(self.text); }
                    accepted => { root.filter-accepted(); }
                    // Escape is the one key this box must not just insert
                    // or ignore: intercepting it here (returning `accept`)
                    // is what lets FILTER own it instead of it falling
                    // through to `TextInput`'s own built-in handling
                    // (which has no notion of "cancel"). Enter is
                    // deliberately left to fall through (`reject`) so
                    // `TextInput`'s own `single-line` handling fires its
                    // built-in `accepted` callback above, the same path
                    // any other single-line `TextInput` commit takes.
                    key-pressed(event) => {
                        if (event.text == Key.Escape) {
                            root.filter-escaped();
                            accept
                        } else {
                            reject
                        }
                    }
                }
            }
        }
    }

    forward-focus: focus-scope;
}
